<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arcade Hub</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: #1a1a1a;
            color: #ffffff;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
        }

        /* Views management */
        .view {
            display: none;
            width: 100%;
            height: 100vh;
            position: absolute;
            top: 0;
            left: 0;
        }

        .active-view {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        /* Navigation Button */
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: bold;
            color: #fff;
            background-color: rgba(83, 83, 83, 0.9);
            border: 2px solid #fff;
            border-radius: 5px;
            cursor: pointer;
            z-index: 100;
            transition: background-color 0.2s ease;
        }

        .back-btn:hover {
            background-color: rgba(255, 255, 255, 0.3);
        }

        /* --- INDEX MENU STYLES --- */
        #menu-view h1 {
            font-size: 3rem;
            margin-bottom: 2rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .game-menu {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .card {
            background-color: #2a2a2a;
            border-radius: 10px;
            padding: 20px;
            width: 220px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: transform 0.2s ease, background-color 0.2s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            background-color: #333333;
        }

        .card h2 {
            margin-top: 0;
            font-size: 1.5rem;
        }

        .card p {
            color: #aaa;
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        .btn {
            display: inline-block;
            padding: 10px 20px;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .btn:hover {
            background-color: #0056b3;
        }

        /* --- DINO GAME STYLES --- */
        #dino-view {
            background-color: #f7f7f7;
            color: #333;
        }

        #game-container {
            position: relative;
            width: 600px;
            height: 200px;
            background-color: #fff;
            border-bottom: 2px solid #333;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        #dino {
            position: absolute;
            bottom: 0px;
            left: 50px;
            width: 40px;
            height: 43px;
            background-color: #535353;
            border-radius: 4px;
        }

        #dino::after {
            content: '';
            position: absolute;
            top: 6px;
            right: 6px;
            width: 6px;
            height: 6px;
            background-color: #fff;
        }

        .cactus {
            position: absolute;
            bottom: 0px;
            width: 20px;
            height: 40px;
            background-color: #2e7d32;
            border-radius: 3px 3px 0 0;
        }

        #score {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 18px;
            font-weight: bold;
            color: #535353;
        }

        #game-over {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: #535353;
        }

        #game-over h1 {
            margin: 0 0 10px 0;
            font-size: 24px;
        }

        /* --- SHOOTER GAME STYLES --- */
        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 10px;
            height: 10px;
            margin-top: -5px;
            margin-left: -5px;
            border: 2px solid rgba(255, 255, 255, 0.8);
            border-radius: 50%;
            pointer-events: none;
            z-index: 10;
        }

        #shooter-ui {
            position: absolute;
            top: 20px;
            right: 20px;
            color: #fff;
            font-size: 24px;
            font-weight: bold;
            text-shadow: 2px 2px 4px #000;
            z-index: 10;
        }

        #instructions {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: rgba(0, 0, 0, 0.6);
            color: #fff;
            font-size: 24px;
            z-index: 20;
            cursor: pointer;
        }

        #shooter-canvas-container {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
        }
    </style>
    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <!-- 1. MENU VIEW -->
    <div id="menu-view" class="view active-view">
        <h1>Select a Game</h1>
        <div class="game-menu">
            <div class="card">
                <h2>Dino Runner</h2>
                <p>Classic 2D jump-and-run game. Avoid the cacti!</p>
                <button class="btn" onclick="switchView('dino-view')">Play Dino</button>
            </div>
            <div class="card">
                <h2>3D FPS Target</h2>
                <p>1st-person 3D shooter built with Three.js. Shoot targets!</p>
                <button class="btn" onclick="switchView('shooter-view')">Play Shooter</button>
            </div>
        </div>
    </div>

    <!-- 2. DINO GAME VIEW -->
    <div id="dino-view" class="view">
        <button class="back-btn" onclick="switchView('menu-view')">← Back to Index</button>
        <p>Press <b>SPACEBAR</b> or <b>UP ARROW</b> to jump!</p>
        <div id="game-container">
            <div id="score">Score: 0</div>
            <div id="dino"></div>
            <div id="game-over">
                <h1>GAME OVER</h1>
                <p>Press Space to Restart</p>
            </div>
        </div>
    </div>

    <!-- 3. SHOOTER GAME VIEW -->
    <div id="shooter-view" class="view">
        <button class="back-btn" onclick="switchView('menu-view')">← Back to Index</button>
        <div id="crosshair"></div>
        <div id="shooter-ui">Score: <span id="shooter-score">0</span></div>
        <div id="instructions">
            <h1>CLICK TO PLAY</h1>
            <p>Use <b>WASD</b> to move | <b>MOUSE</b> to look | <b>LEFT CLICK</b> to shoot</p>
        </div>
        <div id="shooter-canvas-container"></div>
    </div>

    <script>
        // --- NAVIGATION ROUTER ---
        function switchView(viewId) {
            document.querySelectorAll('.view').forEach(view => {
                view.classList.remove('active-view');
            });
            document.getElementById(viewId).classList.add('active-view');

            // Handle switching states
            if (viewId === 'dino-view') {
                stopShooterGame();
                startDinoGame();
            } else if (viewId === 'shooter-view') {
                stopDinoGame();
                startShooterGame();
            } else {
                stopDinoGame();
                stopShooterGame();
            }
        }

        // --- DINO GAME CODE ---
        const dino = document.getElementById('dino');
        const gameContainer = document.getElementById('game-container');
        const scoreDisplay = document.getElementById('score');
        const gameOverDisplay = document.getElementById('game-over');

        let isJumping = false;
        let isGameOver = false;
        let dinoScore = 0;
        let scoreInterval;
        let cactusTimeout;
        let dinoActive = false;

        function handleDinoInput(event) {
            if (!dinoActive) return;
            if (event.code === 'Space' || event.code === 'ArrowUp') {
                if (isGameOver) {
                    resetDinoGame();
                } else if (!isJumping) {
                    jump();
                }
            }
        }

        document.addEventListener('keydown', handleDinoInput);

        function jump() {
            let position = 0;
            isJumping = true;

            let upInterval = setInterval(() => {
                if (position >= 100) {
                    clearInterval(upInterval);
                    let downInterval = setInterval(() => {
                        if (position <= 0) {
                            clearInterval(downInterval);
                            isJumping = false;
                        }
                        position -= 5;
                        position = Math.max(0, position);
                        dino.style.bottom = position + 'px';
                    }, 20);
                }
                position += 8;
                dino.style.bottom = position + 'px';
            }, 20);
        }

        function createCactus() {
            if (isGameOver || !dinoActive) return;

            const cactus = document.createElement('div');
            cactus.classList.add('cactus');
            gameContainer.appendChild(cactus);

            let cactusPosition = 600;
            cactus.style.left = cactusPosition + 'px';

            let timer = setInterval(() => {
                let dinoBottom = parseInt(window.getComputedStyle(dino).getPropertyValue('bottom'));
                
                if (cactusPosition > 50 && cactusPosition < 90 && dinoBottom < 40) {
                    clearInterval(timer);
                    endDinoGame();
                }

                cactusPosition -= 6;
                cactus.style.left = cactusPosition + 'px';

                if (cactusPosition < -20) {
                    clearInterval(timer);
                    cactus.remove();
                }
            }, 20);

            let randomTime = Math.random() * (2000 - 1000) + 1000;
            if (!isGameOver && dinoActive) {
                cactusTimeout = setTimeout(createCactus, randomTime);
            }
        }

        function startDinoGame() {
            dinoActive = true;
            isGameOver = false;
            dinoScore = 0;
            scoreDisplay.innerText = 'Score: ' + dinoScore;
            gameOverDisplay.style.display = 'none';

            scoreInterval = setInterval(() => {
                dinoScore++;
                scoreDisplay.innerText = 'Score: ' + dinoScore;
            }, 100);

            createCactus();
        }

        function endDinoGame() {
            isGameOver = true;
            clearInterval(scoreInterval);
            clearTimeout(cactusTimeout);
            gameOverDisplay.style.display = 'block';
            document.querySelectorAll('.cactus').forEach(c => c.remove());
        }

        function resetDinoGame() {
            dino.style.bottom = '0px';
            startDinoGame();
        }

        function stopDinoGame() {
            dinoActive = false;
            isGameOver = true;
            clearInterval(scoreInterval);
            clearTimeout(cactusTimeout);
            document.querySelectorAll('.cactus').forEach(c => c.remove());
        }

        // --- SHOOTER GAME CODE ---
        let scene, camera, renderer, animationFrameId;
        let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false;
        let prevTime = performance.now();
        const velocity = new THREE.Vector3();
        const direction = new THREE.Vector3();
        const targets = [];
        let shooterScore = 0;
        let isLocked = false;
        let pitch = 0, yaw = 0;
        let shooterInitialized = false;

        const instructions = document.getElementById('instructions');
        const shooterScoreDisplay = document.getElementById('shooter-score');

        function initShooter() {
            const container = document.getElementById('shooter-canvas-container');
            
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x87ceeb);
            scene.fog = new THREE.FogExp2(0x87ceeb, 0.015);

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            container.appendChild(renderer.domElement);

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
            dirLight.position.set(20, 40, 20);
            dirLight.castShadow = true;
            scene.add(dirLight);

            const floorGeo = new THREE.PlaneGeometry(200, 200);
            const floorMat = new THREE.MeshStandardMaterial({ color: 0x33aa33 });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            floor.receiveShadow = true;
            scene.add(floor);

            for (let i = 0; i < 20; i++) {
                const pillarGeo = new THREE.BoxGeometry(2, 10, 2);
                const pillarMat = new THREE.MeshStandardMaterial({ color: 0x888888 });
                const pillar = new THREE.Mesh(pillarGeo, pillarMat);
                pillar.position.set(
                    (Math.random() - 0.5) * 100,
                    5,
                    (Math.random() - 0.5) * 100
                );
                pillar.castShadow = true;
                scene.add(pillar);
            }

            instructions.addEventListener('click', () => {
                document.body.requestPointerLock();
            });

            document.addEventListener('pointerlockchange', () => {
                if (document.pointerLockElement === document.body) {
                    isLocked = true;
                    instructions.style.display = 'none';
                } else {
                    isLocked = false;
                    instructions.style.display = 'flex';
                }
            });

            document.addEventListener('mousemove', (event) => {
                if (!isLocked) return;

                yaw -= (event.movementX || 0) * 0.002;
                pitch -= (event.movementY || 0) * 0.002;
                pitch = Math.max(-Math.PI / 2 + 0.01, Math.min(Math.PI / 2 - 0.01, pitch));

                camera.rotation.set(0, 0, 0);
                camera.rotation.y = yaw;
                camera.rotation.x = pitch;
                camera.rotation.order = 'YXZ';
            });

            document.addEventListener('keydown', (e) => {
                switch (e.code) {
                    case 'KeyW': moveForward = true; break;
                    case 'KeyA': moveLeft = true; break;
                    case 'KeyS': moveBackward = true; break;
                    case 'KeyD': moveRight = true; break;
                }
            });

            document.addEventListener('keyup', (e) => {
                switch (e.code) {
                    case 'KeyW': moveForward = false; break;
                    case 'KeyA': moveLeft = false; break;
                    case 'KeyS': moveBackward = false; break;
                    case 'KeyD': moveRight = false; break;
                }
            });

            const raycaster = new THREE.Raycaster();
            document.addEventListener('mousedown', (event) => {
                if (!isLocked || event.button !== 0) return;

                raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
                const intersects = raycaster.intersectObjects(targets);

                if (intersects.length > 0) {
                    const hitObject = intersects[0].object;
                    scene.remove(hitObject);
                    const index = targets.indexOf(hitObject);
                    if (index > -1) targets.splice(index, 1);

                    shooterScore += 10;
                    shooterScoreDisplay.innerText = shooterScore;
                    createTarget();
                }
            });

            window.addEventListener('resize', () => {
                if (!camera || !renderer) return;
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });

            shooterInitialized = true;
        }

        function createTarget() {
            const targetGeo = new THREE.SphereGeometry(1.2, 32, 32);
            const targetMat = new THREE.MeshStandardMaterial({ color: 0xff2222, roughness: 0.3 });
            const target = new THREE.Mesh(targetGeo, targetMat);

            target.position.set(
                (Math.random() - 0.5) * 60,
                1.5 + Math.random() * 5,
                (Math.random() - 0.5) * 60
            );

            target.castShadow = true;
            scene.add(target);
            targets.push(target);
        }

        function animateShooter() {
            animationFrameId = requestAnimationFrame(animateShooter);

            const time = performance.now();

            if (isLocked) {
                const delta = (time - prevTime) / 1000;

                velocity.x -= velocity.x * 10.0 * delta;
                velocity.z -= velocity.z * 10.0 * delta;

                direction.z = Number(moveForward) - Number(moveBackward);
                direction.x = Number(moveRight) - Number(moveLeft);
                direction.normalize();

                if (moveForward || moveBackward) velocity.z -= direction.z * 100.0 * delta;
                if (moveLeft || moveRight) velocity.x -= direction.x * 100.0 * delta;

                const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
                forward.y = 0;
                forward.normalize();

                const side = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                side.y = 0;
                side.normalize();

                camera.position.addScaledVector(forward, -velocity.z * delta);
                camera.position.addScaledVector(side, -velocity.x * delta);
                camera.position.y = 2;
            }

            targets.forEach((target, index) => {
                target.position.y += Math.sin(time * 0.003 + index) * 0.005;
            });

            prevTime = time;
            renderer.render(scene, camera);
        }

        function startShooterGame() {
            if (!shooterInitialized) {
                initShooter();
            }

            // Reset player position and targets
            camera.position.set(0, 2, 0);
            targets.forEach(t => scene.remove(t));
            targets.length = 0;
            shooterScore = 0;
            shooterScoreDisplay.innerText = shooterScore;

            for (let i = 0; i < 10; i++) {
                createTarget();
            }

            animateShooter();
        }

        function stopShooterGame() {
            if (document.pointerLockElement === document.body) {
                document.exitPointerLock();
            }
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
            }
        }
    </script>
</body>
</html>
