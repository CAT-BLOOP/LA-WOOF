<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dinosaur Game</title>

    <style>
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f7f7f7;
            font-family: Arial, sans-serif;
            user-select: none;
        }

        #back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: bold;
            color: #fff;
            background-color: #535353;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }

        #back-btn:hover {
            background-color: #333;
        }

        #game-container {
            position: relative;
            width: 600px;
            height: 200px;
            background-color: #fff;
            border-bottom: 2px solid #333;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        /* =========================
           DINO
        ========================= */

        #dino {
            position: absolute;
            bottom: 0;
            left: 50px;
            width: 45px;
            height: 48px;
            z-index: 5;
        }

        /* Dino body */
        #dino .body {
            position: absolute;
            bottom: 7px;
            left: 7px;
            width: 29px;
            height: 30px;
            background: #535353;
            border-radius: 5px 8px 3px 3px;
        }

        /* Dino head */
        #dino .head {
            position: absolute;
            top: 0;
            right: 1px;
            width: 29px;
            height: 25px;
            background: #535353;
            border-radius: 7px 8px 2px 2px;
        }

        /* Dino snout */
        #dino .snout {
            position: absolute;
            top: 13px;
            right: -5px;
            width: 12px;
            height: 9px;
            background: #535353;
            border-radius: 0 4px 3px 0;
        }

        /* Dino tail */
        #dino .tail {
            position: absolute;
            bottom: 18px;
            left: 0;
            width: 15px;
            height: 8px;
            background: #535353;
            transform: rotate(-25deg);
            border-radius: 5px;
        }

        /* Dino arm */
        #dino .arm {
            position: absolute;
            top: 27px;
            right: 3px;
            width: 13px;
            height: 5px;
            background: #535353;
            transform: rotate(25deg);
            border-radius: 3px;
        }

        /* Dino legs */
        #dino .leg1,
        #dino .leg2 {
            position: absolute;
            bottom: 0;
            width: 7px;
            height: 13px;
            background: #535353;
            border-radius: 2px;
        }

        #dino .leg1 {
            left: 11px;
        }

        #dino .leg2 {
            left: 27px;
        }

        /* Dino eye */
        #dino .eye {
            position: absolute;
            top: 6px;
            right: 7px;
            width: 5px;
            height: 5px;
            background: white;
            border-radius: 50%;
        }

        #dino .pupil {
            position: absolute;
            top: 7px;
            right: 8px;
            width: 3px;
            height: 3px;
            background: #222;
            border-radius: 50%;
        }

        /* =========================
           CACTUS
        ========================= */

        .cactus {
            position: absolute;
            bottom: 0;
            width: 22px;
            height: 42px;
            background-color: #2e7d32;
            border-radius: 5px 5px 2px 2px;
            z-index: 4;
        }

        .cactus::before,
        .cactus::after {
            content: "";
            position: absolute;
            background: #2e7d32;
            border-radius: 5px;
        }

        /* Left cactus arm */
        .cactus::before {
            width: 10px;
            height: 20px;
            left: -8px;
            top: 15px;
        }

        /* Right cactus arm */
        .cactus::after {
            width: 10px;
            height: 15px;
            right: -8px;
            top: 7px;
        }

        /* Cactus spikes */
        .cactus .spike {
            position: absolute;
            width: 3px;
            height: 3px;
            background: #9ccc65;
            border-radius: 50%;
        }

        .spike1 {
            left: 5px;
            top: 8px;
        }

        .spike2 {
            left: 14px;
            top: 18px;
        }

        .spike3 {
            left: 5px;
            top: 30px;
        }

        /* =========================
           SMALL CACTUS
        ========================= */

        .small-cactus {
            height: 30px;
            width: 17px;
        }

        .small-cactus::before {
            height: 13px;
            top: 10px;
        }

        .small-cactus::after {
            height: 11px;
            top: 5px;
        }

        /* =========================
           ROCK / BUMP
        ========================= */

        .rock {
            position: absolute;
            bottom: 0;
            width: 34px;
            height: 17px;
            background: #777;
            border-radius: 50% 50% 5px 5px;
            z-index: 4;
        }

        .rock::before {
            content: "";
            position: absolute;
            left: 7px;
            top: -5px;
            width: 16px;
            height: 10px;
            background: #777;
            border-radius: 50%;
        }

        .rock::after {
            content: "";
            position: absolute;
            left: 5px;
            bottom: 4px;
            width: 6px;
            height: 3px;
            background: #555;
            border-radius: 50%;
            box-shadow:
                12px -2px #555,
                21px 1px #555;
        }

